`timescale 1ns/100ps

module dms_tb;
(
	reg test_in_line;
	reg [1:0] test_in_adr;
	wire test_out_data0, 
 	wire test_out_data1, 
 	wire test_out_data2, 
 	wire test_out_data3 
);

	dms test (.line(test_in_line), .adr(test_in_adr), .data0(test_out_data0), .data1(test_out_data1), .data2(test_out_data2), .data3(test_out_data3));
	initial
	begin	
		test_in_line = 1'b0;
		test_in_adr = 2'b00;
		#100;
		test_in_line = 1'b1;
		test_in_adr = 2'b00;
		#200;

		test_in_line = 1'b0;
		test_in_adr = 2'b01;
		#100;
		test_in_line = 1'b1;
		test_in_adr = 2'b01;
		#200;

		test_in_line = 1'b0;
		test_in_adr = 2'b10;
		#100;
		test_in_line = 1'b1;
		test_in_adr = 2'b10;
		#200;

		test_in_line = 1'b0;
		test_in_adr = 2'b11;
		#100;
		test_in_line = 1'b1;
		test_in_adr = 2'b11;
		#200;
		$stop;
	end
endmodule